@page "/JSONPlaceholderAPI"
@rendermode InteractiveWebAssembly

@using ProjetoFinal.Client.Models.JsonPlaceHolderApi
@using ProjetoFinal.Client.Services

@inject HttpClient Http
@inject JsonPlaceHolderApiService JsonPlaceHolderApiService

<PageTitle>JSONPlaceholder API</PageTitle>

<h2>Consulta de Usuários - JSONPlaceholder</h2>

<div class="mb-3">
    <label class="form-label">Digite um ID:</label>

    <input type="text"
           class="form-control"
           @bind="JsonPlaceHolderApiService.Id" />
</div>

<button class="btn btn-primary"
        @onclick="ConsultarJph"
        disabled="@isLoading">

    @if (isLoading)
    {
        <span>Consultando...</span>
    }
    else
    {
        <span>Consultar</span>
    }
</button>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger mt-3">
        @errorMessage
    </div>
}

@if (JsonPlaceHolderApiService.Usuario != null)
{
    <div class="mt-3">
        <h4>=== Informações da API ===</h4>

        <p>
            <strong>Nome:</strong>
            @JsonPlaceHolderApiService.Usuario.name
        </p>

        <p>
            <strong>Cidade:</strong>
            @(JsonPlaceHolderApiService.Usuario.address?.city ?? "Desconhecido")
        </p>

        <p>
            <strong>Empresa:</strong>
            @(JsonPlaceHolderApiService.Usuario.company?.name ?? "Desconhecido")
        </p>

        <h4>======================</h4>
    </div>
}

@code {
    private bool isLoading = false;
    private string errorMessage = string.Empty;

    private async Task ConsultarJph()
    {
        isLoading = true;
        errorMessage = string.Empty;

        try
        {
            JsonPlaceHolderApiService.LimparUsuario();

            await JsonPlaceHolderApiService.ConsultarUsuario(Http);

            if (JsonPlaceHolderApiService.Usuario == null)
            {
                errorMessage = "ID não encontrado na lista.";
            }
        }
        catch (ArgumentException ex)
        {
            errorMessage = ex.Message;
        }
        catch (HttpRequestException ex)
        {
            errorMessage = $"Erro de comunicação com a API: {ex.Message}";
        }
        catch (Exception ex)
        {
            errorMessage = $"Ocorreu um erro: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}