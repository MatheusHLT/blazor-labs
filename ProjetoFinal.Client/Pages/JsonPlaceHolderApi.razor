@page "/JSONPlaceholderAPI"
@rendermode InteractiveWebAssembly
@using ProjetoFinal.Client.Models.JsonPlaceHolderApi
@inject HttpClient Http

<PageTitle>JSONPlaceholder API</PageTitle>

<div class="mb-3">
    <label class="form-label">Digite um ID:</label>
    <input type="text" class="form-control" @bind="id" />
</div>
<button class="btn btn-primary" @onclick="ConsultarJph">Consultar</button>

@if (root != null)
{
    <div class="mt-3">
        <p>
        <h4>=== Informações da API ===</h4>
        </p>
        <p><strong>Nome:</strong> @root.name</p>
        <p><strong>Cidade:</strong> @(root.address?.city ?? "Desconhecido")</p>
        <p><strong>Empresa:</strong> @(root.company?.name ?? "Desconhecido")</p>
        <h4>======================</h4>
    </div>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger mt-3">@errorMessage</div>
}

@code {
    private string id;
    private Root root;
    private string errorMessage;

    private async Task ConsultarJph()
    {
        errorMessage = string.Empty;
        root = null;

        if (string.IsNullOrWhiteSpace(id))
        {
            errorMessage = "Por favor insira um ID válido.";
            return;
        }

        try
        {
            var url = "https://jsonplaceholder.typicode.com/users";
            var users = await Http.GetFromJsonAsync<List<Root>>(url);

            if (users != null)
            {
                if (int.TryParse(id, out int numericId))
                {
                    root = users.FirstOrDefault(u => u.id == numericId);
                }

                if (root == null)
                {
                    errorMessage = "ID não encontrado na lista.";
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Ocorreu um erro: {ex.Message}";
        }
    }
}