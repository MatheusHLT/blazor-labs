@page "/media"
@rendermode InteractiveWebAssembly

@using ProjetoFinal.Client.Services

@inject MediaService MediaService

<PageTitle>Calcular Média</PageTitle>

<div class="container mt-5">
    <div class="card shadow mx-auto" style="max-width: 500px; border-radius: 12px;">

        <div class="card-header bg-primary text-white text-center" style="border-top-left-radius: 12px; border-top-right-radius: 12px;">
            <h3 class="mb-1 fw-bold">Calcular Média</h3>
            <span class="badge text-white fw-bold px-3 py-2 mt-1 shadow-sm">
                Média para Aprovação: 7.0
            </span>
        </div>

        <div class="card-body p-4">

            <div class="mb-3">
                <label for="nota1" class="form-label fw-semibold text-secondary">Digite a Nota 1:</label>
                <input id="nota1" type="number" class="form-control form-control-lg" @bind="MediaService.Nota1" placeholder="0.0" min="0" max="10" step="0.1" />
            </div>

            <div class="mb-4">
                <label for="nota2" class="form-label fw-semibold text-secondary">Digite a Nota 2:</label>
                <input id="nota2" type="number" class="form-control form-control-lg" @bind="MediaService.Nota2" placeholder="0.0" min="0" max="10" step="0.1" />
            </div>

            <div class="d-grid mb-4">
                <button class="btn btn-primary btn-lg fw-bold shadow-sm" @onclick="CalcularMedia">
                    Calcular Média
                </button>
            </div>

            @if (MediaService.Media != null || !string.IsNullOrEmpty(MediaService.Situacao))
            {
                <div class="border-top pt-3 text-center">

                    @if (MediaService.Media != null)
                    {
                        <h4 class="text-secondary mb-2">
                            Média do Aluno:
                            <span class="text-dark fw-bold">@MediaService.Media?.ToString("0.0#")</span>
                        </h4>
                    }

                    @if (MediaService.Situacao == "Aprovado!")
                    {
                        <div class="alert alert-success fw-bold m-0" role="alert">
                            🎉 @MediaService.Situacao
                        </div>
                    }
                    else if (MediaService.Situacao == "Reprovado!")
                    {
                        <div class="alert alert-danger fw-bold m-0" role="alert">
                            ❌ @MediaService.Situacao
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(MediaService.Situacao))
                    {
                        <div class="alert alert-warning fw-bold m-0" role="alert">
                            ⚠️ @MediaService.Situacao
                        </div>
                    }

                </div>
            }

        </div>
    </div>
</div>

@code {
    private void CalcularMedia()
    {
        MediaService.CalcularMedia();
    }
}
