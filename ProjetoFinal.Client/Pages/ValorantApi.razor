@page "/valorantapi"
@rendermode InteractiveWebAssembly

@using SearchAgentValorantAPI.Models
@using ProjetoFinal.Client.Services

@inject HttpClient Http
@inject ValorantApiService ValorantApiService

<PageTitle>Valorant API</PageTitle>

<h3>Buscar Agente VALORANT</h3>

<div class="mb-3">
    <label for="uuidInput" class="form-label">UUID do Agente:</label>

    <input id="uuidInput"
           class="form-control"
           @bind="ValorantApiService.AgentUuid"
           placeholder="Insira o UUID do agente..." />
</div>

<button class="btn btn-primary mb-4"
        @onclick="BuscarAgente"
        disabled="@isLoading">

    @if (isLoading)
    {
        <span>Buscando...</span>
    }
    else
    {
        <span>Buscar Agente</span>
    }
</button>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">
        @errorMessage
    </div>
}

@if (ValorantApiService.AgentData != null)
{
    <div class="agent-card mt-3">
        <h2>@ValorantApiService.AgentData.displayName</h2>

        @if (!string.IsNullOrEmpty(ValorantApiService.AgentData.fullPortrait))
        {
            <div class="my-3">
                <img src="@ValorantApiService.AgentData.fullPortrait"
                     alt="@ValorantApiService.AgentData.displayName"
                     style="max-height: 400px; object-fit: contain;" />
            </div>
        }

        <p class="lead">
            @ValorantApiService.AgentData.description
        </p>
    </div>
}

@code {
    private bool isLoading = false;
    private string? errorMessage;

    private async Task BuscarAgente()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            ValorantApiService.LimparAgente();

            await ValorantApiService.BuscarAgente(Http);
        }
        catch (ArgumentException ex)
        {
            errorMessage = ex.Message;
        }
        catch (HttpRequestException ex)
        {
            errorMessage = $"Erro de comunicação com a API: {ex.Message}";
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }
}