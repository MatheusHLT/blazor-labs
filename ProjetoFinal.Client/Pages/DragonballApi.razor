@page "/dragonballapi"
@rendermode InteractiveWebAssembly

@using ProjetoFinal.Client.Models.DragonballApi
@using ProjetoFinal.Client.Services

@inject HttpClient Http
@inject DragonballApiService DragonballApiService

<PageTitle>Dragonball API</PageTitle>

<h2>Consulta de Personagens - Dragonball API</h2>

<div class="mb-3">
    <label for="idInput" class="form-label">Digite um ID:</label>

    <input type="text"
           id="idInput"
           class="form-control"
           @bind="DragonballApiService.Id" />
</div>

<button class="btn btn-primary"
        @onclick="ConsultarPersonagem"
        disabled="@isLoading">

    @if (isLoading)
    {
        <span>Consultando...</span>
    }
    else
    {
        <span>Consultar</span>
    }
</button>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger mt-3">
        @errorMessage
    </div>
}

@if (DragonballApiService.Personagem != null)
{
    <div class="mt-3">
        <h4>=== Informações do Personagem ===</h4>

        <p>
            <strong>Nome:</strong>
            @DragonballApiService.Personagem.name
        </p>

        <p>
            <strong>Planeta:</strong>
            @(DragonballApiService.Personagem.originPlanet?.name ?? "Desconhecido")
        </p>

        <p><strong>Transformações:</strong></p>

        @if (DragonballApiService.Personagem.transformations != null &&
             DragonballApiService.Personagem.transformations.Any())
        {
            <ul>
                @foreach (var trans in DragonballApiService.Personagem.transformations)
                {
                    <li>@trans.name</li>
                }
            </ul>
        }
        else
        {
            <p>Nenhuma transformação encontrada.</p>
        }

        <h4>================================</h4>
    </div>
}

@code {
    private bool isLoading = false;
    private string errorMessage = string.Empty;

    private async Task ConsultarPersonagem()
    {
        isLoading = true;
        errorMessage = string.Empty;

        try
        {
            DragonballApiService.LimparPersonagem();

            await DragonballApiService.ConsultarPersonagem(Http);

            if (DragonballApiService.Personagem == null ||
                DragonballApiService.Personagem.id == 0)
            {
                errorMessage = "ID não encontrado.";
            }
        }
        catch (ArgumentException ex)
        {
            errorMessage = ex.Message;
        }
        catch (HttpRequestException ex)
        {
            if (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                errorMessage = "Personagem não encontrado.";
            }
            else
            {
                errorMessage = $"Erro de comunicação com a API: {ex.Message}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Ocorreu um erro: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}