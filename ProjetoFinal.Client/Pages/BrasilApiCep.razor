@page "/brasilapicep"
@rendermode InteractiveWebAssembly

@using ProjetoFinal.Client.Models.BrasilApiCep
@using ProjetoFinal.Client.Services

@inject HttpClient Http
@inject BrasilApiCepService BrasilApiCepService

<PageTitle>Brasil API - CEP</PageTitle>

<h1>Consulta de CEP - BrasilAPI</h1>

<div class="row mb-3">
    <div class="col-md-5">
        <div class="input-group">
            <input type="text"
                   class="form-control"
                   placeholder="Digite o CEP (apenas números)"
                   @bind="BrasilApiCepService.CepInput"
                   maxlength="8" />

            <button class="btn btn-primary"
                    @onclick="BuscarCep"
                    disabled="@isLoading">

                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    <span> Buscando...</span>
                }
                else
                {
                    <span>Buscar</span>
                }
            </button>
        </div>

        <small class="text-muted">Ex: 89010025</small>
    </div>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger" role="alert">
        @errorMessage
    </div>
}

@if (BrasilApiCepService.ResultadoCep != null)
{
    <div class="card mt-4 shadow-sm">
        <div class="card-header bg-success text-white">
            Resultado para o CEP:
            <strong>@BrasilApiCepService.ResultadoCep.cep</strong>
        </div>

        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <p><strong>Logradouro:</strong> @BrasilApiCepService.ResultadoCep.street</p>
                    <p><strong>Bairro:</strong> @BrasilApiCepService.ResultadoCep.neighborhood</p>
                    <p><strong>Cidade/UF:</strong> @BrasilApiCepService.ResultadoCep.city / @BrasilApiCepService.ResultadoCep.state</p>
                </div>

                <div class="col-md-6">
                    <p><strong>Fuso Horário:</strong> @BrasilApiCepService.ResultadoCep.timezoneName</p>

                    @if (BrasilApiCepService.ResultadoCep.ibge != null)
                    {
                        <p>
                            <strong>Código IBGE (Município):</strong>
                            @BrasilApiCepService.ResultadoCep.ibge.city
                        </p>
                    }

                    @if (BrasilApiCepService.ResultadoCep.location?.coordinates != null)
                    {
                        <p>
                            <strong>Coordenadas:</strong>
                            Lat @BrasilApiCepService.ResultadoCep.location.coordinates.latitude,
                            Lon @BrasilApiCepService.ResultadoCep.location.coordinates.longitude
                        </p>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = false;
    private string errorMessage = string.Empty;

    private async Task BuscarCep()
    {
        isLoading = true;
        errorMessage = string.Empty;

        try
        {
            await BrasilApiCepService.BuscarCep(Http);
        }
        catch (ArgumentException ex)
        {
            BrasilApiCepService.LimparResultado();
            errorMessage = ex.Message;
        }
        catch (HttpRequestException ex)
        {
            BrasilApiCepService.LimparResultado();

            if (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                errorMessage = "CEP não encontrado ou inexistente.";
            }
            else
            {
                errorMessage = $"Erro de comunicação com a API: {ex.Message}";
            }
        }
        catch (Exception ex)
        {
            BrasilApiCepService.LimparResultado();
            errorMessage = $"Ocorreu um erro inesperado: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}