
@page "/pokeapi"
@rendermode InteractiveWebAssembly

@using ProjetoFinal.Client.Models.PokeApi
@using ProjetoFinal.Client.Services

@inject HttpClient Http
@inject PokeApiService PokeApiService

<PageTitle>Buscar Pokémon</PageTitle>

<h1>Poke API</h1>

<div class="mb-3">
    <label for="pokemonName">Nome do Pokémon:</label>
    <input id="pokemonName"
           class="form-control"
           style="max-width: 400px;"
           @bind="PokeApiService.SearchName"
           placeholder="Digite o nome do Pokémon (ex: ditto)" />
</div>

<button class="btn btn-primary" @onclick="BuscarPokemon">
    Buscar Pokémon
</button>

@if (isLoading)
{
    <p class="mt-3"><em>Carregando...</em></p>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <p class="mt-3 text-danger">@errorMessage</p>
}
else if (PokeApiService.Pokemon != null)
{
    <div class="mt-4">
        <h2>Detalhes do Pokémon</h2>

        <img src="@PokeApiService.Pokemon.Sprites.Other.OfficialArtwork.FrontDefault"
             alt="@PokeApiService.Pokemon.Name"
             style="max-width: 200px;" />

        <p><strong>ID:</strong> @PokeApiService.Pokemon.Id</p>
        <p><strong>Nome:</strong> @PokeApiService.Pokemon.Name</p>
        <p><strong>Altura:</strong> @(PokeApiService.Pokemon.Height / 10.0) m</p>
        <p><strong>Peso:</strong> @(PokeApiService.Pokemon.Weight / 10.0) kg</p>
    </div>
}

@code {
    private bool isLoading = false;
    private string? errorMessage;

    private async Task BuscarPokemon()
    {
        if (string.IsNullOrWhiteSpace(PokeApiService.SearchName))
        {
            return;
        }

        isLoading = true;
        errorMessage = null;

        try
        {
            await PokeApiService.BuscarPokemon(Http);
        }
        catch (HttpRequestException)
        {
            PokeApiService.LimparPokemon();
            errorMessage = "Pokémon não encontrado. Verifique o nome digitado.";
        }
        catch (Exception ex)
        {
            PokeApiService.LimparPokemon();
            errorMessage = $"Ocorreu um erro: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}